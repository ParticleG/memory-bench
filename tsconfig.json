{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["vite/client", "bun"]
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.d.ts",
    "web/**/*.vue",
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
